# Environment Variables for Skedence Unified

# Firebase Configuration (REQUIRED)
# Get these from Firebase Console: Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Error Tracking (OPTIONAL - Production)
# Get from Sentry.io dashboard after creating a project
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Development Only (OPTIONAL)
# Set to 'true' to use Firebase emulators during local development
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Production Deployment
# These environment variables should be set in your hosting platform (Firebase Hosting, Vercel, etc.)
# DO NOT commit actual values to git - this file is for documentation only
