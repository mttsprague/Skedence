rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check file size based on plan
    // Default: 10MB for most plans, 100MB for enterprise
    function validateFileSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }
    
    // Allow users to upload and read their own documents
    match /users/{userId}/documents/{allPaths=**} {
      // User can read and write their own documents
      allow read: if request.auth != null 
                  && request.auth.uid == userId;
      
      // Validate file uploads
      // - Max 10MB per file (reasonable default for most plans)
      // - Only PDF files allowed
      // - User must be authenticated
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && validateFileSize(10)
                   && request.resource.contentType == 'application/pdf';
    }
    
    // Organization-level document storage (waivers, contracts, etc.)
    match /organizations/{orgId}/documents/{allPaths=**} {
      // Members of the org can read documents
      allow read: if request.auth != null;
                  // TODO: Add actual org membership check via Firestore
      
      // Org admins can upload documents
      // Enforce file size limits based on subscription plan
      allow write: if request.auth != null
                   && validateFileSize(25)
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }
    
    // Trainer profile images
    match /trainers/{trainerId}/profile/{imageFile} {
      // Anyone authenticated can read trainer profile images
      allow read: if request.auth != null;
      
      // Only the trainer can upload their profile image
      // Max 5MB for profile images
      allow write: if request.auth != null
                   && validateFileSize(5)
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Client profile images
    match /users/{userId}/profile/{imageFile} {
      // Anyone authenticated can read profile images
      allow read: if request.auth != null;
      
      // Only the user can upload their own profile image
      // Max 5MB for profile images
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && validateFileSize(5)
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
