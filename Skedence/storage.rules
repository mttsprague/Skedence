rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check file size based on plan
    // Default: 10MB for most plans, 100MB for enterprise
    function validateFileSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }
    
    // Allow users to upload and read their own documents
    // Note: userId here is firstName_lastName format, not Firebase Auth UID
    // TODO: Add proper auth.uid to firstName_lastName mapping check
    match /users/{userId}/documents/{allPaths=**} {
      // Any authenticated user can read documents
      allow read: if request.auth != null;
      
      // Validate file uploads
      // - Max 10MB per file (reasonable default for most plans)
      // - Only PDF files allowed
      // - User must be authenticated
      // - Temporarily permissive: allows any authenticated user to upload
      //   (tighten after implementing proper auth.uid -> firstName_lastName mapping)
      allow write: if request.auth != null 
                   && validateFileSize(10)
                   && request.resource.contentType == 'application/pdf';
    }
    
    // Organization-level document storage (waivers, contracts, etc.)
    match /organizations/{orgId}/documents/{allPaths=**} {
      // Members of the org can read documents
      allow read: if request.auth != null;
                  // TODO: Add actual org membership check via Firestore
      
      // Org admins can upload documents
      // Enforce file size limits based on subscription plan
      allow write: if request.auth != null
                   && validateFileSize(25)
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }
    
    // Trainer avatar images uploaded by organization owners/admins
    match /organizations/{orgId}/trainers/avatars/{imageFile} {
      // Anyone authenticated can read trainer avatars
      allow read: if request.auth != null;
      
      // Org owners and admins can upload trainer avatars
      // Max 5MB for avatar images
      allow write: if request.auth != null
                   && validateFileSize(5)
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Marketing videos - publicly accessible for website embedding
    match /marketing-videos/{videoFile} {
      // Anyone can read (no authentication required)
      allow read: if true;
      
      // Only authenticated admins can upload (manual upload via Console)
      allow write: if request.auth != null
                   && validateFileSize(100)
                   && request.resource.contentType.matches('video/.*');
    }
    
    // Trainer profile images
    match /trainers/{trainerId}/profile/{imageFile} {
      // Anyone authenticated can read trainer profile images
      allow read: if request.auth != null;
      
      // Only the trainer can upload their profile image
      // Max 5MB for profile images
      allow write: if request.auth != null
                   && validateFileSize(5)
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Client profile images
    // Note: userId here is firstName_lastName format, not Firebase Auth UID
    match /users/{userId}/profile/{imageFile} {
      // Anyone authenticated can read profile images
      allow read: if request.auth != null;
      
      // Any authenticated user can upload profile images
      // Max 5MB for profile images
      // TODO: Add proper auth.uid to firstName_lastName mapping check
      allow write: if request.auth != null
                   && validateFileSize(5)
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
