rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // MULTI-TENANT SECURITY RULES
    // All data is scoped by orgId. Access is controlled via orgMembers collection.
    // =========================================================================

    // =========================================================================
    // GLOBAL HELPER FUNCTIONS
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user has an active membership in the organization
    function isMemberOfOrg(orgId) {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/orgMembers/$(request.auth.uid + '_' + orgId))
        && get(/databases/$(database)/documents/orgMembers/$(request.auth.uid + '_' + orgId)).data.isActive == true
        && get(/databases/$(database)/documents/orgMembers/$(request.auth.uid + '_' + orgId)).data.orgId == orgId;
    }

    // Get user's role in an organization
    function getUserOrgRole(orgId) {
      let memberDoc = get(/databases/$(database)/documents/orgMembers/$(request.auth.uid + '_' + orgId));
      return memberDoc.data.role;
    }

    // Check if user has a specific role in an organization
    function hasOrgRole(orgId, role) {
      return isMemberOfOrg(orgId) && getUserOrgRole(orgId) == role;
    }

    // Check if user is owner of the organization
    function isOrgOwner(orgId) {
      return hasOrgRole(orgId, 'owner');
    }

    // Check if user is admin or owner in the organization
    function isOrgAdmin(orgId) {
      return hasOrgRole(orgId, 'owner') || hasOrgRole(orgId, 'admin');
    }

    // Check if user is a trainer in the organization
    function isOrgTrainer(orgId) {
      return hasOrgRole(orgId, 'trainer') || isOrgAdmin(orgId);
    }

    // Check if document belongs to user's organization
    function belongsToUserOrg() {
      return isSignedIn() && 'orgId' in resource.data && isMemberOfOrg(resource.data.orgId);
    }

    // Check if new document belongs to user's organization
    function newDocBelongsToUserOrg() {
      return isSignedIn() && 'orgId' in request.resource.data && isMemberOfOrg(request.resource.data.orgId);
    }

    // =========================================================================
    // ORGANIZATION MEMBERSHIP COLLECTION (Source of Truth)
    // =========================================================================
    match /orgMembers/{membershipId} {
      // Users can read their own membership records by checking the document ID pattern
      // Pattern: {uid}_{orgId} - allows reading without accessing resource.data
      // This is critical for isMemberOfOrg() checks to work properly
      allow get: if isSignedIn() && membershipId.matches('^' + request.auth.uid + '_[a-zA-Z0-9]+$');
      
      // Allow list queries filtered by userId or orgId (for admin panels)
      allow list: if isSignedIn();
      
      // Users can create their own membership during registration
      // OR owners/admins can create memberships for new trainers in their org
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid
        || isOrgAdmin(request.resource.data.orgId)
      );
      
      // Only org owners/admins can update/delete memberships
      allow update, delete: if false;
    }

    // =========================================================================
    // ORGANIZATIONS COLLECTION
    // =========================================================================
    match /organizations/{orgId} {
      // Members can read their own organization (including pricing structure, branding, subscription)
      // This includes get() and snapshot listeners (which use get internally)
      // Also allow reading for invite code validation during registration
      allow read: if isMemberOfOrg(orgId);
      
      // Allow querying by inviteCode for registration validation (even if not signed in)
      allow list: if true;
      
      // Admins can update organization settings (including pricing structure)
      // Owners have full control
      allow update: if isOrgAdmin(orgId);
      
      // Allow authenticated users to create organizations during registration
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      
      // Only owners can delete
      allow delete: if isOrgOwner(orgId);
      
      // Trainers subcollection within organizations
      match /trainers/{trainerId} {
        // Owners and admins can read all trainers in their org
        // Trainers can read their own profile
        allow get: if isOrgAdmin(orgId) || request.auth.uid == trainerId;
        
        // Owners and admins can list trainers in their org
        allow list: if isOrgAdmin(orgId);
        
        // Owners and admins can create, update trainers in their org
        allow create, update: if isOrgAdmin(orgId);
        
        // Only owners can delete trainers
        allow delete: if isOrgOwner(orgId);
      }
    }

    // =========================================================================
    // USERS COLLECTION (Client Profiles)
    // =========================================================================
    match /users/{userId} {
      // Anyone authenticated can list/query users (for checking invited accounts)
      allow list: if isSignedIn();
      
      // User can read their own profile, or any trainer/admin in their org can read it
      allow get: if isSignedIn() && (
        request.auth.uid == userId 
        || ('orgId' in resource.data && isOrgTrainer(resource.data.orgId))
      );
      
      // Users can create their own user document during registration
      // OR owners/admins can create user documents for new trainers in their org
      allow create: if isSignedIn() && (
        request.auth.uid == userId
        || ('orgId' in request.resource.data && isOrgAdmin(request.resource.data.orgId))
      );

      // User can update their own profile, or trainers/admins in their org
      allow update: if isSignedIn() && (
        request.auth.uid == userId
        || ('orgId' in resource.data && isOrgAdmin(resource.data.orgId))
      );

      // Only admins can delete user profiles
      allow delete: if 'orgId' in resource.data && isOrgAdmin(resource.data.orgId);

      // Lesson Packages subcollection
      match /lessonPackages/{packageId} {
        // Owner, or trainers/admins in the same org can read packages
        allow read: if isSignedIn() && (
          request.auth.uid == userId 
          || ('orgId' in resource.data && isOrgTrainer(resource.data.orgId))
        );

        // Owner or admins can create packages
        allow create: if isSignedIn() && (
          request.auth.uid == userId 
          || ('orgId' in request.resource.data && isOrgAdmin(request.resource.data.orgId))
        ) && newDocBelongsToUserOrg();

        // Trainers/admins can update packages (for booking decrements)
        allow update: if 'orgId' in request.resource.data 
          && isOrgTrainer(request.resource.data.orgId);
        
        // Only admins can delete
        allow delete: if 'orgId' in resource.data && isOrgAdmin(resource.data.orgId);
      }

      // Documents subcollection
      match /documents/{documentId} {
        // Owner, or trainers in same org can read documents
        allow read: if isSignedIn() && (
          request.auth.uid == userId 
          || ('orgId' in resource.data && isOrgTrainer(resource.data.orgId))
        );
        
        allow create: if isSignedIn() && request.auth.uid == userId;
        
        allow update, delete: if isSignedIn() && (
          request.auth.uid == userId
          || ('orgId' in resource.data && isOrgAdmin(resource.data.orgId))
        );
      }
      
      // Payment Methods subcollection
      match /paymentMethods/{methodId} {
        // Owner or admins in same org can read payment methods
        allow read: if isSignedIn() && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/users/$(userId)).data.orgId != null
            && isOrgAdmin(get(/databases/$(database)/documents/users/$(userId)).data.orgId)
        );
        
        // Only backend can write payment methods
        allow write: if false;
      }
    }

    // =========================================================================
    // TRAINERS COLLECTION
    // =========================================================================
    match /trainers/{trainerId} {
      // Anyone in the same org can get a specific trainer profile
      allow get: if 'orgId' in resource.data && isMemberOfOrg(resource.data.orgId);
      
      // Allow list queries for authenticated users (will be filtered by org)
      allow list: if isSignedIn();

      // Trainer can update their own profile, or admins in their org
      allow update: if isSignedIn() && (
        request.auth.uid == trainerId
        || ('orgId' in resource.data && isOrgAdmin(resource.data.orgId))
      );

      // Users can create their own trainer profile during registration
      // OR owners/admins can create trainer profiles for new trainers in their org
      allow create: if isSignedIn() && (
        request.auth.uid == trainerId
        || ('orgId' in request.resource.data && isOrgAdmin(request.resource.data.orgId))
      );
      
      // Only admins can delete
      allow delete: if 'orgId' in resource.data && isOrgAdmin(resource.data.orgId);

      // Schedules subcollection
      match /schedules/{slotId} {
        // Allow anyone to read schedules if the parent trainer is in their org
        // OR trainer reading their own schedule
        allow read: if isSignedIn() && (
          // Trainer reading their own schedule
          request.auth.uid == trainerId
          // OR member reading schedules of trainer in their org
          || (exists(/databases/$(database)/documents/trainers/$(trainerId))
            && 'orgId' in get(/databases/$(database)/documents/trainers/$(trainerId)).data
            && isMemberOfOrg(get(/databases/$(database)/documents/trainers/$(trainerId)).data.orgId))
        );

        // Trainers can manage their own schedules if they belong to the org
        // Admins/owners can manage any trainer's schedules in their org
        allow create, update, delete: if isSignedIn() && (
          // Trainer managing their own schedule
          (request.auth.uid == trainerId 
            && 'orgId' in request.resource.data 
            && isMemberOfOrg(request.resource.data.orgId))
          // OR admin/owner managing any trainer's schedule in their org
          || (exists(/databases/$(database)/documents/trainers/$(trainerId))
            && 'orgId' in get(/databases/$(database)/documents/trainers/$(trainerId)).data
            && isOrgTrainer(get(/databases/$(database)/documents/trainers/$(trainerId)).data.orgId))
        );
      }
    }

    // =========================================================================
    // BOOKINGS COLLECTION
    // =========================================================================
    match /bookings/{bookingId} {
      // Client can read their own bookings, trainers in same org can read all bookings
      allow read: if isSignedIn() && 'orgId' in resource.data && (
        request.auth.uid == resource.data.clientUID
        || isOrgTrainer(resource.data.orgId)
      );

      // Trainers/admins can create bookings
      allow create: if newDocBelongsToUserOrg() 
        && isOrgTrainer(request.resource.data.orgId);

      // Trainers/admins can update bookings
      allow update: if belongsToUserOrg() 
        && isOrgTrainer(resource.data.orgId);

      // Trainers/admins can delete bookings
      allow delete: if belongsToUserOrg() 
        && isOrgTrainer(resource.data.orgId);
    }

    // =========================================================================
    // CLASSES COLLECTION
    // =========================================================================
    match /classes/{classId} {
      // Anyone in the same org can read classes
      allow read: if 'orgId' in resource.data && isMemberOfOrg(resource.data.orgId);
      
      // Trainers, admins, and owners can create, update, or delete classes
      allow create: if newDocBelongsToUserOrg() 
        && isOrgTrainer(request.resource.data.orgId);
      
      allow update, delete: if belongsToUserOrg() 
        && isOrgTrainer(resource.data.orgId);
      
      // Participants subcollection
      match /participants/{participantId} {
        // Anyone in same org can read participants
        allow read: if existsAfter(/databases/$(database)/documents/classes/$(classId))
          && 'orgId' in getAfter(/databases/$(database)/documents/classes/$(classId)).data
          && isMemberOfOrg(getAfter(/databases/$(database)/documents/classes/$(classId)).data.orgId);
        
        // Users in org can register themselves
        allow create: if isSignedIn() 
          && request.auth.uid == participantId
          && request.resource.data.userId == request.auth.uid
          && existsAfter(/databases/$(database)/documents/classes/$(classId))
          && 'orgId' in getAfter(/databases/$(database)/documents/classes/$(classId)).data
          && isMemberOfOrg(getAfter(/databases/$(database)/documents/classes/$(classId)).data.orgId);
        
        // Users can unregister themselves, admins can remove anyone
        allow delete: if isSignedIn() && (
          request.auth.uid == participantId 
          || (existsAfter(/databases/$(database)/documents/classes/$(classId))
            && 'orgId' in getAfter(/databases/$(database)/documents/classes/$(classId)).data
            && isOrgAdmin(getAfter(/databases/$(database)/documents/classes/$(classId)).data.orgId))
        );
      }
    }

    // =========================================================================
    // TRANSACTIONS COLLECTION
    // =========================================================================
    match /transactions/{transactionId} {
      // Clients can read their own transactions
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid
        || ('orgId' in resource.data && isOrgAdmin(resource.data.orgId))
      );
      
      // Only backend/cloud functions can write transactions
      allow write: if false;
    }

    // =========================================================================
    // COLLECTION GROUP RULE FOR SCHEDULES
    // Allows queries across all trainer schedules within same org
    // =========================================================================
    match /{path=**}/schedules/{slotId} {
      // Allow authenticated users to query schedules
      // Individual documents are protected by the main schedules rule above
      allow read: if isSignedIn();
    }

    // =========================================================================
    // LOCATIONS COLLECTION
    // =========================================================================
    match /locations/{locationId} {
      // Anyone in the same org can read active locations
      allow read: if 'orgId' in resource.data && isMemberOfOrg(resource.data.orgId);
      
      // Only admins can create, update, or delete locations
      allow create: if newDocBelongsToUserOrg() 
        && isOrgAdmin(request.resource.data.orgId);
      
      allow update, delete: if belongsToUserOrg() 
        && isOrgAdmin(resource.data.orgId);
    }

    // =========================================================================
    // DENY ALL OTHER ACCESS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
